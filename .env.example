# Copia este archivo como .env y completa tus claves. NUNCA subas el .env a GitHub.

# Pinecone. Clave en https://app.pinecone.io -> API Keys
PINECONE_API_KEY=

# Nombre del indice (solo minusculas, numeros y guiones; hasta 45 caracteres)
INDEX_NAME=rag-gobierno-de-datos

# Namespace dentro del indice (opcional; por defecto: mercado-austral)
PINECONE_NAMESPACE=mercado-austral

# Embeddings: Gemini (gratis). Clave en https://aistudio.google.com/apikey
GOOGLE_API_KEY=
